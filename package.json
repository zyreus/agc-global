{
  "name": "agc-global",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-pm2-win-paths.cjs",
    "dev": "npm run dev:full",
    "dev:vite": "npm --prefix frontend run dev",
    "dev:mix": "npm --prefix backend run dev",
    "dev:api": "node scripts/dev-artisan-serve.cjs",
    "dev:full": "concurrently -n api,vite -c magenta,cyan \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:pm2": "node scripts/pm2-with-project-pipes.mjs pm2 startOrRestart ecosystem.config.cjs --update-env",
    "dev:pm2:fg": "node scripts/pm2-with-project-pipes.mjs pm2-runtime start ecosystem.config.cjs",
    "dev:pm2:stop": "node scripts/pm2-with-project-pipes.mjs pm2 delete ecosystem.config.cjs",
    "dev:pm2:restart": "node scripts/pm2-with-project-pipes.mjs pm2 startOrRestart ecosystem.config.cjs --update-env",
    "dev:pm2:logs": "node scripts/pm2-with-project-pipes.mjs pm2 logs",
    "pm2": "node scripts/pm2-with-project-pipes.mjs pm2",
    "pm2:start:ecosystem": "node scripts/pm2-with-project-pipes.mjs pm2 startOrRestart ecosystem.config.cjs --update-env",
    "pm2:start:all": "node scripts/pm2-with-project-pipes.mjs pm2 start all",
    "build": "npm run build:vite",
    "build:vite": "npm --prefix frontend run build",
    "lint:vite": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pm2": "^7.0.1"
  }
}
